; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be edited manually as well.

config_version=5

[application]

config/name="Tangga Snake"
config/features=PackedStringArray("4.3", "Forward Plus")
run/main_scene="res://scenes/ui/loading_screen.tscn"
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/global/game_manager.gd"
AudioManager="*res://scripts/global/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="forward_plus"
